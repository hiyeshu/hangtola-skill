    "codegen": "tsx packages/domain/scripts/emit-skill-validator.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
