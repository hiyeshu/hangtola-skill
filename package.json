{
  "name": "hangtola",
  "private": true,
  "type": "module",
  "description": "夯到拉排行榜：多模态 Agent Skill + 单文件 tier list 编辑器",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
